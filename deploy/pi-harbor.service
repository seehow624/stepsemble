[Unit]
Description=Pi Harbor web workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pi-harbor
ExecStart=__NODE__ %h/.local/share/pi-harbor/server.js
Environment=HOME=%h
Environment=PI_HARBOR_HOST=127.0.0.1
Environment=PI_HARBOR_TOKEN_FILE=%h/.config/pi-harbor/token
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
