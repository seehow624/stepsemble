<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace __USER__, __NODE__, and __PIBIN__ before installing.
     The token is read from a user-owned file with mode 600. -->
<dict>
  <key>Label</key>
  <string>com.piharbor.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>/Users/__USER__/.local/share/pi-harbor/server.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PI_HARBOR_TOKEN_FILE</key>
    <string>/Users/__USER__/.config/pi-harbor/token</string>
    <key>PI_HARBOR_PORT</key>
    <string>__PORT__</string>
    <!-- Put Tailscale Serve or another HTTPS gateway in front of loopback. -->
    <key>PI_HARBOR_HOST</key>
    <string>127.0.0.1</string>
    <key>PI_HARBOR_SECURE_COOKIE</key>
    <string>1</string>
    <key>PI_BIN</key>
    <string>__PIBIN__</string>
    <key>PI_HARBOR_BROWSE_ROOTS</key>
    <string>/Users/__USER__,/Volumes</string>
    <key>HOME</key>
    <string>/Users/__USER__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>6000</integer>

  <key>StandardOutPath</key>
  <string>/Users/__USER__/.local/state/pi-harbor/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/__USER__/.local/state/pi-harbor/server-error.log</string>
</dict>
</plist>
