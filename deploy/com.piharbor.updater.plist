<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace __USER__ and install this LaunchAgent on each Pi Harbor computer. -->
<dict>
  <key>Label</key>
  <string>com.piharbor.updater</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/__USER__/.local/share/pi-harbor-bin/pi-harbor-update.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/__USER__</string>
    <key>PI_HARBOR_UPDATE_REPO</key>
    <string>seehow624/pi-harbor</string>
    <key>PI_HARBOR_UPDATE_REF</key>
    <string>stable</string>
    <key>PI_HARBOR_INSTALL_DIR</key>
    <string>/Users/__USER__/.local/share/pi-harbor</string>
    <key>PI_HARBOR_SERVICE_LABEL</key>
    <string>com.piharbor.server</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/__USER__/.local/state/pi-harbor/updater.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/__USER__/.local/state/pi-harbor/updater-error.log</string>
</dict>
</plist>
