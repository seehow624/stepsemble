<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Replace __USER__ and install this LaunchAgent on each Pi Harbor computer. -->
<dict>
  <key>Label</key>
  <string>com.piweb.updater</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/__USER__/.local/share/pi-web-bin/pi-web-update.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/__USER__</string>
    <key>PI_WEB_UPDATE_REPO</key>
    <string>seehow624/pi-harbor</string>
    <key>PI_WEB_UPDATE_REF</key>
    <string>master</string>
    <key>PI_WEB_INSTALL_DIR</key>
    <string>/Users/__USER__/.local/share/pi-web</string>
    <key>PI_WEB_SERVICE_LABEL</key>
    <string>com.piweb.server</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/pi-web-updater.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pi-web-updater.err.log</string>
</dict>
</plist>
