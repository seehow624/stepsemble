{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stepsemble:protocol:1.0.0",
  "title": "Stepsemble Protocol v1",
  "description": "Negotiation is implemented. Domain shapes are reserved contracts, not declarations of shipped capabilities. See README.md.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "handshake": {
      "type": "object",
      "properties": {
        "clientVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
        },
        "protocolMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "protocolMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "platform": {
          "type": "string",
          "enum": [
            "web",
            "macos",
            "ios",
            "windows",
            "android",
            "linux"
          ]
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        }
      },
      "required": [
        "clientVersion",
        "protocolMin",
        "protocolMax",
        "platform",
        "deviceId",
        "capabilities"
      ],
      "additionalProperties": true
    },
    "negotiated": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mode": {
          "const": "legacy-compatible"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "disabledCapabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "handshakeBytes": {
              "const": 16384
            }
          },
          "required": [
            "handshakeBytes"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "protocolVersion",
        "schemaVersion",
        "hostVersion",
        "mode",
        "capabilities",
        "disabledCapabilities",
        "limits"
      ],
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "protocolVersion",
        "error"
      ],
      "additionalProperties": true
    },
    "nativeReference": {
      "type": "object",
      "properties": {
        "harnessId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "nativeSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "harnessId",
        "adapterVersion",
        "nativeSessionId",
        "reference"
      ],
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "native": {
          "$ref": "#/$defs/nativeReference"
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "launchProfileId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "archived"
          ]
        }
      },
      "required": [
        "sessionId",
        "native",
        "workspaceId",
        "launchProfileId",
        "createdAt",
        "status"
      ],
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "starting",
            "running",
            "waiting_approval",
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "runId",
        "sessionId",
        "state",
        "createdAt"
      ],
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "denied",
            "expired",
            "cancelled"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "once",
            "run",
            "session"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "request": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "approvalId",
        "sessionId",
        "runId",
        "status",
        "scope",
        "expiresAt",
        "request"
      ],
      "additionalProperties": true
    },
    "launchProfile": {
      "type": "object",
      "properties": {
        "launchProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "harnessId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "authMode": {
          "type": "string",
          "enum": [
            "native_subscription",
            "api_key",
            "local",
            "unknown"
          ]
        },
        "billingMode": {
          "type": "string",
          "enum": [
            "subscription",
            "metered",
            "local",
            "unknown"
          ]
        },
        "credentialReference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "launchProfileId",
        "harnessId",
        "modelId",
        "sourceId",
        "authMode",
        "billingMode",
        "credentialReference"
      ],
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.]*$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "protocolVersion",
        "eventId",
        "sessionId",
        "runId",
        "sequence",
        "type",
        "createdAt",
        "payload"
      ],
      "additionalProperties": true
    },
    "cursor": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "sessionId",
        "sequence",
        "generation"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 500
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "hasMore"
      ],
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "commandId",
        "sessionId",
        "idempotencyKey",
        "type",
        "payload"
      ],
      "additionalProperties": true
    }
  }
}
