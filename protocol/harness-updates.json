{
  "registryVersion": 1,
  "harnesses": [
    {
      "id": "codex",
      "label": "Codex CLI",
      "commands": ["codex"],
      "executableEnv": "STEPSEMBLE_CODEX_BIN",
      "package": "@openai/codex",
      "check": { "kind": "source-aware", "package": "@openai/codex", "brewPackage": "codex" },
      "update": { "kind": "source-aware", "package": "@openai/codex", "brewPackage": "codex", "args": ["update"], "verify": true },
      "note": "Codex updates must preserve a proven installed source: Homebrew uses brew upgrade, npm uses npm install --global only when the selected executable belongs to @openai/codex, and the official standalone package uses codex update. Standalone releases have no non-mutating update check, so the status remains unknown until the user confirms an update; unknown shims fail closed."
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "commands": ["claude"],
      "executableEnv": "STEPSEMBLE_CLAUDE_CODE_BIN",
      "check": { "kind": "registry-version", "package": "@anthropic-ai/claude-code" },
      "update": { "kind": "command", "args": ["update"] },
      "note": "Claude Code's updater installs immediately and has no dry-run flag, so the check compares the installed version with the version published to the official npm package. Reading the registry does not modify the installation, and the update still runs Claude Code's own updater after explicit confirmation."
    },
    {
      "id": "opencode",
      "label": "OpenCode",
      "commands": ["opencode"],
      "executableEnv": "STEPSEMBLE_OPENCODE_BIN",
      "check": { "kind": "brew-or-official", "package": "opencode" },
      "update": { "kind": "brew-or-command", "package": "opencode", "args": ["upgrade"] }
    },
    {
      "id": "pi",
      "label": "Pi Agent",
      "commands": ["pi"],
      "executableEnv": "STEPSEMBLE_PI_BIN",
      "package": "@earendil-works/pi-coding-agent",
      "check": { "kind": "npm-outdated" },
      "update": { "kind": "npm-global" }
    },
    {
      "id": "hermes",
      "label": "Hermes Agent",
      "commands": ["hermes"],
      "executableEnv": "STEPSEMBLE_HERMES_BIN",
      "check": { "kind": "command", "args": ["update", "--check"] },
      "update": { "kind": "command", "args": ["update", "--yes", "--backup"] }
    },
    {
      "id": "gemini-cli",
      "label": "Gemini CLI",
      "commands": ["gemini"],
      "executableEnv": "STEPSEMBLE_GEMINI_BIN",
      "check": { "kind": "version-only" },
      "update": { "kind": "manual", "reason": "Gemini CLI update channel varies by package manager" }
    },
    {
      "id": "cline",
      "label": "Cline",
      "commands": [],
      "executableEnv": "STEPSEMBLE_CLINE_BIN",
      "check": { "kind": "manual" },
      "update": { "kind": "manual", "reason": "Cline is installed and updated by the editor extension host" }
    },
    {
      "id": "kilo",
      "label": "Kilo Code",
      "commands": [],
      "executableEnv": "STEPSEMBLE_KILO_BIN",
      "check": { "kind": "manual" },
      "update": { "kind": "manual", "reason": "Kilo Code is installed and updated by the editor extension host" }
    },
    {
      "id": "grok-build",
      "label": "Grok Build",
      "commands": [],
      "executableEnv": "STEPSEMBLE_GROK_BUILD_BIN",
      "check": { "kind": "manual" },
      "update": { "kind": "manual", "reason": "Grok Build does not expose a stable local updater contract" }
    },
    {
      "id": "antigravity",
      "label": "Google Antigravity",
      "commands": [],
      "executableEnv": "STEPSEMBLE_ANTIGRAVITY_BIN",
      "check": { "kind": "manual" },
      "update": { "kind": "manual", "reason": "Antigravity is updated by its host distribution" }
    }
  ]
}
